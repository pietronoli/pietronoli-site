---
import Base from '../layouts/Base.astro';

const cases = [
  {
    client: 'Unicredit Real Estate S.c.p.A.',
    sector: 'Immobiliare',
    problem: 'Gestione delle informazioni sugli immobili tramite l\'applicazione IBM Maximo Asset Management, priva di una reportistica strutturata.',
    solution: 'Creazione e manutenzione di oltre 400 report IBM Cognos dedicati, a Milano e Roma.',
    result: 'Più di 290 giornate di lavoro, da febbraio 2014 a ottobre 2016.'
  },
  {
    client: 'Samsung Electronics Italia S.p.A.',
    sector: 'Elettronica di consumo ed elettrodomestici',
    problem: 'Dati aziendali di billing, budget, stock, ordini, consegne e marketing dispersi su fonti separate.',
    solution: 'Creazione di un ambiente di system integration & reporting con data warehouse e Cognos BI 8, integrato con Cognos Planning.',
    result: 'Più di 110 giornate di lavoro, da settembre 2006 a ottobre 2007.'
  },
  {
    client: 'Mapa Spontex Italia S.p.A.',
    sector: 'Prodotti per la pulizia della casa',
    problem: 'Analisi dei dati di vendita e della contrattualistica aziendale senza un ambiente OLAP dedicato.',
    solution: 'Analisi e implementazione di reportistica aziendale OLAP a Pogliano Milanese.',
    result: 'Più di 230 giornate di lavoro, da giugno 2008 a ottobre 2016.'
  },
  {
    client: 'Abbott S.r.l.',
    sector: 'Ricerca, produzione e commercializzazione di farmaci',
    problem: 'Nessun ambiente di analisi delle statistiche di vendita e pianificazione prodotti per una rete di oltre 700 venditori.',
    solution: 'Creazione dell\'ambiente di analisi e reportistica, con attività di implementazione, delivery, supporto e training.',
    result: 'Più di 90 giornate di lavoro, da novembre 2001 a settembre 2002.'
  }
];

const testimonial = {
  quote: 'Ho conosciuto Pietro 8 anni fa e lo ricordo bene: la sua profonda conoscenza tecnica, le sue competenze IT e la sua esperienza lo hanno reso, e lo rendono ancora, un partner inestimabile nello sviluppo dei progetti, specialmente quando i tempi sono stretti.',
  author: 'Filippo Fontana',
  role: 'Senior BI Consultant, Cegeka Italia'
};
---

<Base
  title="Case studies — Pietro Noli"
  description="Progetti selezionati di consulenza e formazione business intelligence: problema, soluzione, risultato."
>
  <section class="section">
    <div class="wrap" style="max-width:760px;">
      <p class="eyebrow">Case studies</p>
      <h1>Risultati, non solo loghi.</h1>
      <p style="margin-top:1rem; color:var(--text-secondary); font-size:1.1rem;">
        Una selezione di progetti, con il problema di partenza, l'intervento e il risultato misurato.
        I nomi dei clienti restano riservati dove richiesto dagli accordi di riservatezza.
      </p>
    </div>
  </section>

  <hr class="hairline" />

  <section class="section">
    <div class="wrap" style="display:grid; gap:1.5rem;">
      {cases.map((c) => (
        <div class="panel">
          <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:0.5rem;">
            <p style="font-weight:600; font-size:1.05rem;">{c.client}</p>
            <p class="mono" style="font-size:0.78rem; color:var(--text-secondary);">{c.sector}</p>
          </div>
          <div class="grid grid--3" style="margin-top:0.75rem;">
            <div>
              <p class="mono" style="font-size:0.78rem; color:var(--text-secondary); margin-bottom:0.4rem;">Problema</p>
              <p style="font-size:0.95rem; color:var(--text-secondary);">{c.problem}</p>
            </div>
            <div>
              <p class="mono" style="font-size:0.78rem; color:var(--text-secondary); margin-bottom:0.4rem;">Intervento</p>
              <p style="font-size:0.95rem; color:var(--text-secondary);">{c.solution}</p>
            </div>
            <div>
              <p class="mono" style="font-size:0.78rem; color:var(--signal-blue); margin-bottom:0.4rem;">Risultato</p>
              <p style="font-size:0.95rem; font-weight:500;">{c.result}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="hairline" />

  <section class="section">
    <div class="wrap panel" style="max-width:760px;">
      <p style="font-size:1.15rem; font-style:italic; color:var(--text-secondary); margin-bottom:1rem;">
        «{testimonial.quote}»
      </p>
      <p class="mono" style="font-size:0.85rem;">{testimonial.author} — {testimonial.role}</p>
    </div>
  </section>
</Base>
